<Project>

  <!-- Build output is kept OUT of the project folder on purpose.
       The project lives inside "Muj disk", which Google Drive mirrors, and
       bin/obj would be tens of MB re-uploaded after every single build. The
       sources are about 1 MB and DO belong in the backup; compiler output is
       made again in seconds and does not.

       LOCALAPPDATA rather than a hard-coded path: a literal path breaks on a
       rename or another account, which is the trap this project already has
       written down for phone/build.ps1.

       The folder is an approved write location (additionalDirectories in
       ~/.claude/settings.json) - without that the write guard refuses. -->

  <!-- A publish through a profile gets a tree of its own.

       The self-contained publish for the installer builds into bin\Release as
       well, and leaves a .NET runtime there (hostfxr, hostpolicy, coreclr).
       From then on the plain build's executable looks for .NET beside itself,
       finds nothing and asks the user to install .NET - measured 16.09.2026,
       and "dotnet clean" does not take those files away. Kept apart, the
       debugging build stays runnable whatever was published before it.

       Keyed on PublishProfile because it comes from the command line and is
       known this early; SelfContained is set inside the profile, which is read
       too late to move the output folders. -->
  <PropertyGroup>
    <DdlBuildRoot>$(LOCALAPPDATA)\da-bt-dynamic-lock-build\</DdlBuildRoot>
    <DdlBuildRoot Condition="'$(PublishProfile)' != ''">$(DdlBuildRoot)_publish-$(PublishProfile)\</DdlBuildRoot>
    <BaseOutputPath>$(DdlBuildRoot)$(MSBuildProjectName)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(DdlBuildRoot)$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

</Project>
