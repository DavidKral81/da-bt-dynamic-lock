<Window
    x:Class="DaBtDynamicLock.App.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The flyout from the tray icon. Most encounters with this app are a two
         second glance - "is it watching?" - and today that costs opening the
         whole window. So this carries the answer and the three things anyone
         ever does about it. -->

    <Grid x:Name="Root" Padding="16" RowSpacing="14"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- state -->
        <Grid Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The ring is the silence measured against the threshold, so how
                 close a lock is can be seen without reading a number. -->
            <Grid Width="56" Height="56">
                <Ellipse Width="56" Height="56" StrokeThickness="5"
                         Stroke="{ThemeResource ControlStrongStrokeColorDisabledBrush}"/>
                <Ellipse x:Name="Ring" Width="56" Height="56" StrokeThickness="5"
                         Stroke="#22A050" StrokeDashCap="Round"
                         StrokeDashArray="0,999" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="Silence" Text="" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="StateLine" Text="" FontSize="20" FontWeight="SemiBold"/>
                <!-- Secondary text stays close to full strength on purpose:
                     faint grey on a dark ground is the one thing this project
                     is told never to ship. -->
                <TextBlock x:Name="DetailLine" Text="" FontSize="13" Opacity="0.95"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- actions -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PauseButton" Grid.Column="0" Click="OnPause"
                    HorizontalAlignment="Stretch" Padding="10,12" CornerRadius="6">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <FontIcon x:Name="PauseGlyph" Glyph="&#xE769;" FontSize="16"/>
                    <TextBlock x:Name="PauseLabel" Text="" FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Click="OnLockNow"
                    HorizontalAlignment="Stretch" Padding="10,12" CornerRadius="6">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="16"/>
                    <TextBlock x:Name="LockLabel" Text="" FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Click="OnSettings"
                    HorizontalAlignment="Stretch" Padding="10,12" CornerRadius="6">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="16"/>
                    <TextBlock x:Name="SettingsLabel" Text="" FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- this network -->
        <Border Grid.Row="2" CornerRadius="6" Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE701;" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NetworkName" Text="" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NetworkHint" Text="" FontSize="11" Opacity="0.9"/>
                </StackPanel>
                <!-- MinWidth="0" is not optional: a ToggleSwitch keeps about
                     154 px of width for its label even when the label is
                     empty, and it eats that space out of the text beside it. -->
                <ToggleSwitch x:Name="NetworkSwitch" Grid.Column="2"
                              OnContent="" OffContent="" MinWidth="0"
                              VerticalAlignment="Center" Toggled="OnNetworkToggled"/>
            </Grid>
        </Border>

        <!-- footer -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- The log link sits beside "last locked" rather than in the
                 settings: the log answers "was that lock deserved?", and that
                 is asked exactly when somebody reads when it locked. -->
            <TextBlock x:Name="LastLock" Text="" FontSize="12" Opacity="0.9"
                       VerticalAlignment="Center"/>
            <HyperlinkButton x:Name="LogLink" Grid.Column="1" Click="OnOpenLog"
                             Content="" Padding="4,0" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
