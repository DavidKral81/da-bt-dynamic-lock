<Window
    x:Class="DaBtDynamicLock.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DaBtDynamicLock.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The settings window, laid out the way the approved mockup shows it:
         topics down the left, ONE COLUMN OF CARDS on each page.

         One column is not a style choice. The 1.5 window put the cards in a
         shared two-column grid, so a tall card on the left stretched the row
         and left a hole under the short one on the right - a fault that came
         back three times, the last one found by the user. With one column per
         page it has nowhere to come from.

         No text is written in here. Every label is set in ApplyTexts(), so the
         two languages have exactly one place to be filled in from and a label
         that gets forgotten shows up empty rather than stuck in Czech. -->

    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <!-- On the ROOT GRID, not on the Window: a WinUI 3 Window is not a
             FrameworkElement and has no Resources of its own. -->
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush"
                        Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,14"/>
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <!-- 0.95, not the 0.75 that looks tasteful in a mockup: faint grey
                 on a dark ground is the one thing this project is told never to
                 ship. -->
            <Style x:Key="CardHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Opacity" Value="0.95"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="GroupHead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="2,8,0,-6"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================================== top strip -->
        <!-- The language used to be chosen up here, with flags. It moved onto
             the Aplikace page as an ordinary drop-down, where the rest of the
             settings are: a flag names a country, not a language, and picking
             between a British and an American one for "English" has no right
             answer. -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Padding="20,14,20,10">
            <TextBlock x:Name="AppName" Text="" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ===================================================== navigation -->
        <Grid Grid.Row="1" Grid.Column="0" Width="212" Margin="12,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Selection is read from the item's Tag, never from its label:
                 deciding anything from displayed text breaks the moment the
                 language changes, and this project has that on its list of
                 repeated faults. -->
            <ListView x:Name="Nav" SelectionMode="Single"
                      SelectionChanged="OnPageChosen">
                <ListViewItem Tag="overview">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16"/>
                        <TextBlock x:Name="NavOverview" Text="" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="signal">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE9D2;" FontSize="16"/>
                        <TextBlock x:Name="NavSignal" Text="" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="phone">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8EA;" FontSize="16"/>
                        <TextBlock x:Name="NavPhone" Text="" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="locking">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE72E;" FontSize="16"/>
                        <TextBlock x:Name="NavLocking" Text="" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="networks">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE701;" FontSize="16"/>
                        <TextBlock x:Name="NavNetworks" Text="" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="app">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" FontSize="16"/>
                        <TextBlock x:Name="NavApp" Text="" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <TextBlock x:Name="NavFoot" Grid.Row="1" Text="" FontSize="12" Opacity="0.9"
                       Margin="16,10,0,0"/>
        </Grid>

        <!-- ========================================================== pages -->
        <ScrollViewer x:Name="PagesScroller" Grid.Row="1" Grid.Column="1"
                      Padding="24,0,24,24"
                      VerticalScrollBarVisibility="Auto">
            <!-- Stretched up to a ceiling, not sized to fit: with Left the grid
                 shrank to whatever its content needed, so the cards came out a
                 different width on every page. Stacked blocks have to line up,
                 and the width is decided HERE, once, rather than by each card's
                 own content.

                 MinHeight is the viewport's own height, so a page that wants to
                 fill the window can. A scroller measures its content with
                 unlimited height, so without this a page is only ever as tall as
                 its content - which left the chart ending a third of the way
                 down and the rest of the window empty. -->
            <Grid x:Name="Pages" MaxWidth="640" HorizontalAlignment="Stretch"
                  MinHeight="{Binding ViewportHeight, ElementName=PagesScroller}">

                <!-- ======== overview -->
                <StackPanel x:Name="PageOverview" Spacing="14">
                    <TextBlock x:Name="TitleOverview" Text="" FontSize="24" FontWeight="SemiBold"/>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="104" Height="104" VerticalAlignment="Top">
                                <Ellipse Width="104" Height="104" StrokeThickness="8"
                                         Stroke="{ThemeResource ControlStrongStrokeColorDisabledBrush}"/>
                                <Ellipse x:Name="Ring" Width="104" Height="104" StrokeThickness="8"
                                         Stroke="#22A050" StrokeDashCap="Round"
                                         StrokeDashArray="0,999" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="RingValue" Text="" FontSize="20"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="RingOf" Text="" FontSize="11" Opacity="0.95"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Name="StateLine" Text="" FontSize="22"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StateWhy" Text="" FontSize="13" Opacity="0.95"
                                           TextWrapping="Wrap"/>

                                <Grid x:Name="Readout" ColumnSpacing="20" RowSpacing="10"
                                      Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock x:Name="KeyPhone" Text="" FontSize="11" Opacity="0.95"/>
                                        <TextBlock x:Name="ValPhone" Text="" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock x:Name="KeySignal" Text="" FontSize="11" Opacity="0.95"/>
                                        <TextBlock x:Name="ValSignal" Text="" FontSize="14"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock x:Name="KeyNetwork" Text="" FontSize="11" Opacity="0.95"/>
                                        <TextBlock x:Name="ValNetwork" Text="" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock x:Name="KeyLastLock" Text="" FontSize="11" Opacity="0.95"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="ValLastLock" Text="" FontSize="14"
                                                       VerticalAlignment="Center"/>
                                            <!-- The log link stands beside "last locked" on
                                                 purpose: the log answers "was that lock
                                                 deserved?", which is asked exactly here. -->
                                            <HyperlinkButton x:Name="LogLink" Content="" FontSize="13"
                                                             Padding="2,0" Click="OnOpenLogFolder"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="Pause15" Content="" Click="OnPause15" CornerRadius="14"
                                Padding="14,7"/>
                        <Button x:Name="Pause60" Content="" Click="OnPause60" CornerRadius="14"
                                Padding="14,7"/>
                        <Button x:Name="PauseStop" Content="" Click="OnEndPause" CornerRadius="14"
                                Padding="14,7"/>
                    </StackPanel>
                </StackPanel>

                <!-- ======== signal -->
                <!-- A Grid, not a stack: the chart is the point of this page, so
                     it takes the height that is left over rather than a number
                     picked in advance. -->
                <Grid x:Name="PageSignal" RowSpacing="14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TitleSignal" Text="" FontSize="24" FontWeight="SemiBold"/>

                    <Border Grid.Row="1" Style="{StaticResource Card}" MinHeight="260">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ChartTitle" Text=""
                                           Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center"/>
                                <!-- The ranges are built in code: their labels are
                                     translated, and one built here would keep the
                                     language it was written in. -->
                                <StackPanel x:Name="RangeButtons" Grid.Column="1"
                                            Orientation="Horizontal" Spacing="4"/>
                            </Grid>

                            <!-- Plain shapes on a Canvas, no charting library: the
                                 whole picture is a polyline, a few grid lines and
                                 some rectangles, and a dependency would have to be
                                 restored before anything could be built. -->
                            <Canvas x:Name="Plot" Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    SizeChanged="OnPlotResized"/>

                            <TextBlock x:Name="ChartSummary" Grid.Row="2" Text=""
                                       Style="{StaticResource CardHint}"/>
                        </Grid>
                    </Border>

                    <!-- Built in code: the swatches have to be the very brushes
                         the chart draws with, not a second set of colours. -->
                    <Grid x:Name="ChartLegend" Grid.Row="2"/>
                </Grid>

                <!-- ======== phone -->
                <StackPanel x:Name="PagePhone" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Name="TitlePhone" Text="" FontSize="24" FontWeight="SemiBold"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="CardPhone" Text="" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="CardPhoneHint" Text="" Style="{StaticResource CardHint}"/>
                            <!-- Filled from the live list. Redrawn only when what
                                 it shows actually changes, and the signature of
                                 what is drawn lives ON this panel, so it cannot
                                 outlive the rows it describes. -->
                            <StackPanel x:Name="DeviceList" Spacing="2" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="CardGone" Text="" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="CardGoneHint" Text="" Style="{StaticResource CardHint}"/>
                            <ComboBox x:Name="WarnAfter" DisplayMemberPath="Label" Margin="0,8,0,0" MinWidth="260"
                                      SelectionChanged="OnWarnAfterChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======== locking -->
                <StackPanel x:Name="PageLocking" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Name="TitleLocking" Text="" FontSize="24" FontWeight="SemiBold"/>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72E;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="SwActive" Text="" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="SwActiveHint" Text="" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="Active" Grid.Column="2" OnContent="" OffContent=""
                                          MinWidth="0" VerticalAlignment="Center"
                                          Toggled="OnActiveToggled"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="GroupWhen" Text="" Style="{StaticResource GroupHead}"/>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE916;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <!-- No explanation under it: the name and the
                                     chosen value already say the whole thing. -->
                                <TextBlock x:Name="LblSilence" Text="" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <ComboBox x:Name="Silence" DisplayMemberPath="Label" Grid.Column="2" Width="280"
                                      VerticalAlignment="Center" SelectionChanged="OnSilenceChanged"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE704;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="LblRange" Text="" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="LblRangeHint" Text="" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <ComboBox x:Name="Range" DisplayMemberPath="Label" Grid.Column="2" Width="280"
                                      VerticalAlignment="Center" SelectionChanged="OnRangeChanged"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7C4;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="SwIdleGuard" Text="" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="SwIdleGuardHint" Text="" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="IdleGuard" Grid.Column="2" OnContent="" OffContent=""
                                          MinWidth="0" VerticalAlignment="Center"
                                          Toggled="OnIdleGuardToggled"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="GroupCountdown" Text="" Style="{StaticResource GroupHead}"/>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE917;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="LblCountdown" Text="" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="LblCountdownHint" Text="" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <ComboBox x:Name="CountdownFrom" DisplayMemberPath="Label" Grid.Column="2" Width="280"
                                      VerticalAlignment="Center" SelectionChanged="OnCountdownChanged"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <!-- "70 % from the top" needs no line under it
                                     saying it is measured from the top. -->
                                <TextBlock x:Name="LblPosition" Text="" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <ComboBox x:Name="Position" DisplayMemberPath="Label" Grid.Column="2" Width="280"
                                      VerticalAlignment="Center" SelectionChanged="OnPositionChanged"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F8;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="SwPrimaryOnly" Text="" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="SwPrimaryOnlyHint" Text="" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="PrimaryOnly" Grid.Column="2" OnContent="" OffContent=""
                                          MinWidth="0" VerticalAlignment="Center"
                                          Toggled="OnPrimaryOnlyToggled"/>
                        </Grid>
                    </Border>

                    <!-- The tray menu pauses for fifteen minutes,
                         which covers most of it; the whole range from five
                         minutes to two days lives here, as it does in 1.5. -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE769;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="CardPause" Text="" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="CardPauseHint" Text="" Style="{StaticResource CardHint}"/>
                                <!-- What the drop-down says is what was CHOSEN;
                                     this says how much is actually left, which
                                     is a different question - the pause runs
                                     down on its own and can be started from the
                                     tray as well. -->
                                <TextBlock x:Name="PauseLeft" Text="" MinHeight="16"
                                           Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <ComboBox x:Name="Pause" DisplayMemberPath="Label" Grid.Column="2" Width="280"
                                      VerticalAlignment="Center" SelectionChanged="OnPauseChosen"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ======== networks -->
                <StackPanel x:Name="PageNetworks" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Name="TitleNetworks" Text="" FontSize="24" FontWeight="SemiBold"/>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE701;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="SwTrusted" Text="" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="SwTrustedHint" Text="" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="TrustedOn" Grid.Column="2" OnContent="" OffContent=""
                                          MinWidth="0" VerticalAlignment="Center"
                                          Toggled="OnTrustedToggled"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="CardNetworks" Text="" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="CardNetworksHint" Text="" Style="{StaticResource CardHint}"/>
                            <StackPanel x:Name="NetworkList" Spacing="2" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======== app -->
                <StackPanel x:Name="PageApp" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Name="TitleApp" Text="" FontSize="24" FontWeight="SemiBold"/>

                    <!-- The language, as an ordinary drop-down like every other
                         choice on these pages. The entries are written in their
                         own language and are NOT translated, so somebody who
                         opened the app in a language they cannot read still
                         recognises their own. -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xF2B7;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="LblLanguage" Text="" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <ComboBox x:Name="LanguageChoice" DisplayMemberPath="Name"
                                      Grid.Column="2" Width="280" VerticalAlignment="Center"
                                      SelectionChanged="OnLanguageChosen"/>
                        </Grid>
                    </Border>

                    <!-- An app that guards the screen is no use if somebody has
                         to remember to start it. -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7E8;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="SwAutostart" Text="" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="SwAutostartHint" Text="" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutostartOn" Grid.Column="2" OnContent="" OffContent=""
                                          MinWidth="0" VerticalAlignment="Center"
                                          Toggled="OnAutostartToggled"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9D5;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="SwLog" Text="" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="SwLogHint" Text="" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="LogOn" Grid.Column="2" OnContent="" OffContent=""
                                          MinWidth="0" VerticalAlignment="Center"
                                          Toggled="OnLogToggled"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="LblFolder" Text="" Style="{StaticResource CardTitle}"/>
                                <!-- The path is shown, not just linked: it is what
                                     somebody attaches to a fault report. -->
                                <TextBlock x:Name="FolderPath" Text="" Style="{StaticResource CardHint}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="OpenFolder" Grid.Column="2" Content=""
                                    VerticalAlignment="Center" Click="OnOpenLogFolder"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE895;" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <!-- The link beside it is called "Releases
                                     page", so a line pointing at it is noise. -->
                                <TextBlock x:Name="LblVersion" Text="" Style="{StaticResource CardTitle}"/>
                            </StackPanel>
                            <HyperlinkButton x:Name="UpdatesLink" Grid.Column="2" Content=""
                                             VerticalAlignment="Center" Click="OnOpenReleases"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton x:Name="ProjectLink" Content="" Click="OnOpenProject"/>
                        <HyperlinkButton x:Name="PhoneAppLink" Content="" Click="OnOpenReleases"/>
                    </StackPanel>

                    <Button x:Name="QuitButton" Content="" Click="OnQuit"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
