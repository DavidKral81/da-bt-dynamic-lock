<Project Sdk="Microsoft.NET.Sdk">

  <!-- The application itself: tray icon, flyout panel, windows.

       Unpackaged (WindowsPackageType None) - a plain .exe, the way the Python
       build is delivered today, so the installer stays the same shape and no
       MSIX signing is involved. Measured with the throwaway prototype: this
       builds without Visual Studio, from a hand-written project file. -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DaBtDynamicLock</AssemblyName>
    <RootNamespace>DaBtDynamicLock.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Platform\Platform.csproj" />
    <ProjectReference Include="..\Engine\Engine.csproj" />
    <!-- The app is also the installer: started under the setup name it puts
         itself in place. There is no second executable, which is what keeps the
         download at one copy of .NET instead of two. -->
    <ProjectReference Include="..\Installer\Installer.csproj" />
  </ItemGroup>

  <!-- The Windows App SDK carries a machine-learning stack and a browser
       control with it. This app draws a tray icon, two small windows and a
       chart made of lines - it calls neither. Measured: they are 40 MB of the
       77 MB published, more than half of what a user would download.

       Dropped at publish time rather than by trimming, which WinUI cannot take
       (its XAML resolves types by reflection). Whether the app still runs
       without them is not assumed: the published copy is started with the
       self-check switch before any of this counts as done.

       (No double hyphen in this comment on purpose: XML forbids it, and that
       is already on this project's list of repeated faults.) -->
  <Target Name="DropUnusedFrameworkParts" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)' == 'onnxruntime'
                  or '%(Filename)' == 'DirectML'
                  or '%(Filename)' == 'Microsoft.ML.OnnxRuntime'
                  or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.AI'))" />
    </ItemGroup>
  </Target>

</Project>
