<?xml version="1.0" encoding="utf-8"?>
<!--
  How the app is published for the installer to carry.

  Self-contained, chosen by David on 13.09.2026 with both options measured:
  37 MB needing the .NET 8 Desktop runtime AND the Windows App SDK 2.4 runtime
  already on the machine, against 175 MB needing nothing at all. The Windows
  App SDK runtime is NOT part of Windows - it arrives with Store apps - and
  this project may not fetch it, because no part of it talks over the network.
  So the larger, self-sufficient build is what gets shipped.

  Use it with:  dotnet publish app-2.0\App\App.csproj -p:PublishProfile=SelfContained

  The machine-learning parts the Windows App SDK brings along are dropped by a
  target in App.csproj; the published copy is then started with the self-check
  switch, because "it published" is not "it runs".
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
