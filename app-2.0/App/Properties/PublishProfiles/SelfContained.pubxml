<?xml version="1.0" encoding="utf-8"?>
<!--
  How the app is published for the installer to carry - ALL of it. The file
  that goes out is exactly what this profile makes; build-setup.ps1 adds no
  switches of its own, so two builds cannot differ by what somebody remembered
  to type.

  Self-contained, with both options measured on 13.09.2026: the smaller build
  needs the .NET 8 Desktop runtime AND the Windows App SDK 2.4 runtime already
  on the machine; this one needs nothing at all. The Windows App SDK runtime is
  NOT part of Windows - it arrives with Store apps - and this project may not
  fetch it, because no part of it talks over the network. So the
  self-sufficient build is what gets shipped: one compressed file of about
  72 MB, which is also the installer.

  Use it with:  dotnet publish app-2.0\App\App.csproj -p:PublishProfile=SelfContained

  The machine-learning parts the Windows App SDK brings along are dropped by a
  target in App.csproj; the published copy is then started with the self-check
  switch, because "it published" is not "it runs".
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
