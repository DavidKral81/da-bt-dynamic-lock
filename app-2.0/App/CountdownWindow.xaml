<Window
    x:Class="DaBtDynamicLock.App.CountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The warning before the screen goes. Information only - it cannot call
         the lock off, and it must not look like a button that could. -->

    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderThickness="1" CornerRadius="10"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Padding="26,18">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE72E;" FontSize="24" Foreground="#E68C14"/>
            <TextBlock x:Name="Message" Text="" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
