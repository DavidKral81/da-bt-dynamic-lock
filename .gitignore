# Developer notes - these stay local.
# They hold internal material (work in progress, notes from conversations)
# that does not belong on a public GitHub. Whatever has public value -
# measurements, technical decisions and their reasons - goes into README.md.
CLAUDE.md
CLAUDE-HISTORIE.md

# Android signing key - NEVER commit.
# Whoever holds it can publish an "update" to your app.
phone/*.jks

# Build artifacts - these belong in Releases, not in the source history
phone/*.apk
installer/*.exe
# build output - never commit (this used to name only the old path
# instalace/_build/, so once the folder was renamed, 1001 PyInstaller files
# made it into a commit)
_build/
installer/_build/

# Portable toolchain (~700 MB) and virtual environment.
# _android-build/ now lives OUTSIDE the project, one level up, so this pattern
# matches nothing today - it stays as a safety net, because putting those 700 MB
# back into the project and committing them is exactly the accident above.
_android-build/
.venv/

# Runtime data. These patterns match by NAME, not by path - a path-based
# pattern would silently stop matching after a move or a rename.
# Note: "config.json" does not match "config.default.json" (different name),
# so the template holding the default settings stays versioned.
dyn_lock.log
dyn_lock.log.1
history.json
config.json

# Measurement and diagnostic output needs no pattern of its own - all three
# tools write into _output/, which is excluded as a whole (see below).
# BEWARE of a bare "track_log.csv" pattern: it also excluded
# tests/track_log.csv, the REFERENCE recording that test_logic.py replays.
# On a fresh clone the test then quietly printed SKIPPED instead of running.

__pycache__/
*.pyc

# all generated output (previews, reports, measurements) - one folder,
# so it does not pile up in the project root
_output/

# .NET build output (2.0). app-2.0/Directory.Build.props already sends these
# outside the project - and outside the mirrored Google Drive folder - so
# normally nothing matches here. It stays as a safety net: a build run without
# those properties (a stray `dotnet build` elsewhere, an IDE with its own
# settings) would otherwise drop a thousand files into a commit, which is
# exactly what happened once with installer/_build/.
# By NAME, not by path, so a rename cannot silently stop it matching.
bin/
obj/


# signing key password - NEVER commit
phone/signing-key-password.txt
phone/*backup*.jks
